# ====================================================================
# FASALSETU ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env.local to configure real backend services
# If left empty, FasalSetu automatically runs in high-fidelity Demo Mode.
# ====================================================================

# Supabase PostgreSQL Database & Authentication (Optional for real backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Production Domain for Public Passport Links & QR Codes
VITE_PUBLIC_APP_URL=https://fasalsetu.in

# Open-Meteo Weather API is open-access and does not require an API key
